# Copy to .env and fill in your own values. Never commit the real .env file.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (used by docker-compose)
POSTGRES_DB=stockroom
POSTGRES_USER=stockroom
POSTGRES_PASSWORD=change-me

# Optional when running without Docker; defaults to a local SQLite file.
# DATABASE_URL=postgres://user:pass@localhost:5432/stockroom
